# OpenPoke Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Railway auto-provides DATABASE_URL for managed PostgreSQL
# For local development, use docker-compose defaults:
DATABASE_URL=postgresql+asyncpg://openpoke:openpoke_dev_password@localhost:5432/openpoke

# =============================================================================
# Redis
# =============================================================================
# Railway auto-provides REDIS_URL for managed Redis
# For local development:
REDIS_URL=redis://localhost:6379/0

# Celery broker and result backend (use different Redis databases)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Google OAuth (Required for authentication)
# =============================================================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth redirect URI (update for production)
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# =============================================================================
# JWT Authentication
# =============================================================================
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars_here

# Token expiration settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# External Services - OpenRouter (LLM)
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# External Services - Composio (Gmail/Calendar integrations)
# =============================================================================
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id_here
COMPOSIO_CALENDAR_AUTH_CONFIG_ID=your_calendar_auth_config_id_here

# =============================================================================
# Server Configuration
# =============================================================================
OPENPOKE_HOST=0.0.0.0
OPENPOKE_PORT=8001

# CORS - comma-separated list of allowed origins
# Use * for development, specific domains for production
OPENPOKE_CORS_ALLOW_ORIGINS=http://localhost:3000

# API documentation
OPENPOKE_ENABLE_DOCS=1
OPENPOKE_DOCS_URL=/docs

# =============================================================================
# Frontend Configuration
# =============================================================================
# Backend API URL (used by Next.js API routes)
PY_SERVER_URL=http://localhost:8001

# Public API URL (used by browser)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Google Client ID (public, for frontend Google Sign-In)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# =============================================================================
# Production Settings (Railway)
# =============================================================================
# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3000

# For Railway production, update these:
# GOOGLE_REDIRECT_URI=https://your-frontend.railway.app/auth/callback
# FRONTEND_URL=https://your-frontend.railway.app
# OPENPOKE_CORS_ALLOW_ORIGINS=https://your-frontend.railway.app
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app
